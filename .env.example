# Cadena de conexión a PostgreSQL (ej. Neon, Supabase, o servidor propio de MACROMEC)
DATABASE_URL=postgresql://usuario:password@host:5432/conteo_sacos

# Clave secreta para firmar los JWT de autenticación. OBLIGATORIA:
# mínimo 32 caracteres; sin ella el login queda deshabilitado.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token compartido entre el módulo de visión (Python) y esta API,
# para que solo el módulo de visión pueda enviar resultados de conteo.
# OBLIGATORIO: mínimo 32 caracteres; sin él POST /api/conteo responde 503.
VISION_API_TOKEN=

# Auth Token de Twilio. OBLIGATORIO para el chatbot de WhatsApp: sin él
# el webhook responde 503. TWILIO_WEBHOOK_URL es opcional: URL pública
# exacta configurada en Twilio (necesaria detrás de proxies como ngrok).
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# SOLO DESARROLLO LOCAL (el endpoint /api/dev/seed-usuarios está
# deshabilitado en producción y si falta DEV_SEED_SECRET).
# Secreto de mínimo 32 caracteres, enviado en el header X-Dev-Seed-Secret.
DEV_SEED_SECRET=
# Usuarios de desarrollo que crea el seed (contraseñas de mínimo 16 caracteres).
DEV_ADMIN_CORREO=
DEV_ADMIN_PASSWORD=
DEV_CLIENTE_CORREO=
DEV_CLIENTE_PASSWORD=
