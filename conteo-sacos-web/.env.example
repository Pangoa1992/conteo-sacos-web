# Cadena de conexión a PostgreSQL (ej. Neon, Supabase, o servidor propio de MACROMEC)
DATABASE_URL=postgresql://usuario:password@host:5432/conteo_sacos

# Clave secreta para firmar los JWT de autenticación (Fase 2)
JWT_SECRET=cambia_esto_por_una_clave_segura

# Token compartido entre el módulo de visión (Python) y esta API,
# para que solo el módulo de visión pueda enviar resultados de conteo.
VISION_API_TOKEN=cambia_esto_tambien
